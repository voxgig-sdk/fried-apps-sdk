# Entity: temporary_email

main: kit: entity: temporary_email: {

  alias: field: {}

  fields: [
    {
      name: "domains"
      req: false
      short: "List of available email domains"
      type: "`$ARRAY`"
    }
  ]

  name: "temporary_email"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/temp-mail/domains"
          parts: [
            "temp-mail"
            "domains"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.domains`"
          }
        }
      ]
    }
  }



}
